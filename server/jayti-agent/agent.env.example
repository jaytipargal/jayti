# Secrets are NOT stored here: the unit also loads /etc/jayti/hub.env
# (JAYTI_PG_DSN, JAYTI_BOOTSTRAP_KEY) and the API key is read from
# /etc/nginx/conf.d/eka-agent-api-key.conf (override: JTAGENT_API_KEY).
RETRIEVAL_URL=http://127.0.0.1:8444
HUB_URL=http://127.0.0.1:8443
JTAGENT_ADAPTER=/opt/jayti/agent/adapters/adapter_2026-09-24_browser_data/final
JTAGENT_GENERATE=1
JTAGENT_THREADS=2
