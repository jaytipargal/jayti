[Unit]
Description=EKA Agent Retrieval Server (FAISS + MiniLM)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/eka-agent
Environment=OMP_NUM_THREADS=2
Environment=TOKENIZERS_PARALLELISM=false
Environment=HF_HOME=/opt/eka-agent/.hf
ExecStart=/opt/eka-agent/retrieval-venv/bin/python /opt/eka-agent/eka_retrieval_server_vps.py
Restart=on-failure
RestartSec=10
MemoryMax=2G

[Install]
WantedBy=multi-user.target
